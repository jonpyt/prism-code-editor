---
import "prism-code-editor/layout.css"
import "prism-code-editor/scrollbar.css"
import "prism-code-editor/guides.css"
import Button from "../components/Button.astro"
---

<Button type="reset">Reset editor</Button>

<script>
	import "prism-code-editor/prism/languages/javascript"
	import { editors, mount } from "./editor/mount"

	mount()

	const form = document.forms[0]
	const editor = editors[0]
	const initial = (editor.textarea.defaultValue = editor.options.value)

	form.onreset = () => {
		editor.setOptions({ value: initial })
	}

	import("./editor/extensions")
</script>
